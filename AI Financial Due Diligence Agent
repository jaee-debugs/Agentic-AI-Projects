a[\"MA50\"].iloc[-1])\n","        else None\n","    )\n","\n","    current_volume = float(data[\"Volume\"].iloc[-1])\n","\n","    average_volume = float(\n","        data[\"Volume\"].tail(20).mean()\n","    )\n","\n","    volume_ratio = (\n","        current_volume / average_volume\n","        if average_volume > 0\n","        else None\n","    )\n","\n","    period_return = (\n","        (current_price - float(data[\"Close\"].iloc[0]))\n","        / float(data[\"Close\"].iloc[0])\n","    ) * 100\n","\n","    return {\n","        \"current_price\": current_price,\n","        \"ma20\": ma20,\n","        \"ma50\": ma50,\n","        \"volatility_percent\": float(volatility),\n","        \"current_volume\": current_volume,\n","        \"average_volume_20\": average_volume,\n","        \"volume_ratio\": volume_ratio,\n","        \"period_return_percent\": float(period_return)\n","    }"],"metadata":{"id":"QyMhEF1Q3ntB","executionInfo":{"status":"ok","timestamp":1788882114669,"user_tz":-330,"elapsed":2,"user":{"displayName":"JAEE SAKHARKAR","userId":"13551643430399893779"}}},"execution_count":54,"outputs":[]},{"cell_type":"markdown","source":["Tool 1: Retrieve Stock Data\n","\n","This is our first third-party tool: yfinance.\n","\n","The lab explicitly requires retrieving market data programmatically and gives examples such as TCS.NS, RELIANCE.NS, and INFY.NS."],"metadata":{"id":"gErlnf-632xi"}},{"cell_type":"code","source":["def prepare_financial_evidence(symbol):\n","\n","    market_result = get_stock_data(symbol)\n","\n","    if market_result[\"status\"] != \"success\":\n","        return market_result\n","\n","    indicators = calculate_financial_indicators(\n","        market_result[\"data\"]\n","    )\n","\n","    evidence = {\n","        \"symbol\": symbol,\n","        \"current_price\": market_result[\"current_price\"],\n","        \"previous_close\": market_result[\"previous_close\"],\n","        \"price_change\": market_result[\"price_change\"],\n","        \"pe